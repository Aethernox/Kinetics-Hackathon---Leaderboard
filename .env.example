# Kinetics Hackathon 2026 - Live Leaderboard Configuration

# Data Source Mode: 'google-sheets' | 'mock' | 'simulator'
VITE_DATA_SOURCE=mock

# Google Sheet ID (Extract from sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
VITE_GOOGLE_SHEET_ID=your_google_sheet_id_here

# Sheet Tab Name (Default: Sheet1)
VITE_GOOGLE_SHEET_NAME=Sheet1

# Google Sheets API v4 Key (Optional - Public / viewable sheets sync via GViz without API Key)
VITE_GOOGLE_SHEETS_API_KEY=

# Real-time polling interval in milliseconds (Default: 3500ms)
VITE_LEADERBOARD_POLL_INTERVAL=3500

# Optional Spline 3D Scene URL
VITE_SPLINE_SCENE_URL=https://prod.spline.design/fba5a24b-a843-461d-b983-e5c140313420/scene.splinecode
